services:
  navidrome:
    image: deluan/navidrome:latest
    container_name: navidrome

    user: "1000:1000"

    ports:
      - "4533:4533"

    environment:
      TZ: "Asia/Kolkata"

      ND_LOGLEVEL: "info"

    volumes:
      # Navidrome database/config/cache
      - ./data:/data

      # Music library
      - /mnt/storage/music:/music:ro

    restart: unless-stopped
