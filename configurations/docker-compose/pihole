services:
  pihole:
    image: pihole/pihole:latest
    container_name: pihole

    hostname: pihole

    ports:
      # DNS
      - "53:53/tcp"
      - "53:53/udp"

      # Web interface
      - "8080:80/tcp"

    environment:
      TZ: "Asia/Kolkata"

      # DO NOT PUT YOUR REAL PASSWORD IN GITHUB
      FTLCONF_webserver_api_password: "${PIHOLE_WEB_PASSWORD}"

      # Allows Pi-hole to receive DNS queries from Docker/Tailscale
      FTLCONF_dns_listeningMode: "all"

    volumes:
      - ./data/etc-pihole:/etc/pihole
      - ./data/etc-dnsmasq.d:/etc/dnsmasq.d

    restart: unless-stopped
